# Gmail SMTP (used by every backend and dashboard email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Quza Support <your-gmail-address@gmail.com>"
# Public URL of E-commerce-webapp. Payment emails use this to link to /track/:token.
STOREFRONT_URL=http://localhost:3000
