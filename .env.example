# ============================================================
# DATABASE
# ============================================================
# Neon pooled connection string (for app runtime on Render)
# In Neon dashboard: Connection Details → toggle "Pooled connection" ON → copy
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Neon direct (non-pooled) connection string (for prisma migrate on Render build)
# In Neon dashboard: Connection Details → toggle "Pooled connection" OFF → copy
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# APP
# ============================================================
PORT=4000
NODE_ENV=production

# ============================================================
# JWT
# ============================================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="your-jwt-secret-here"

# ============================================================
# CORS — comma-separated list of allowed frontend origins
# ============================================================
# Add all your deployed frontend URLs here
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://seller.yourdomain.com

# ============================================================
# STOREFRONT URL
# ============================================================
# Public URL of E-commerce-webapp (used in payment confirmation emails)
STOREFRONT_URL=https://yourdomain.com

# ============================================================
# CLOUDINARY — image & video uploads
# ============================================================
# Get these from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: folder name inside your Cloudinary account
CLOUDINARY_FOLDER=quza

# ============================================================
# MPESA API KEYS
# ============================================================
CONSUMER_KEY=your-consumer-key
CONSUMER_SECRET=your-consumer-secret
PASSKEY=your-passkey
SHORT_CODE=174379
# Must be your live Render backend URL in production
MPESA_CALLBACK_URL=https://your-backend.onrender.com/mpesa/callback
SECURITY_CREDENTIAL=your-security-credential

# ============================================================
# EMAIL (Zoho SMTP)
# ============================================================
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=your-email@quzaurban.com
# Use a Zoho App Password
# Generate at: accounts.zoho.com → Security → App Passwords
SMTP_PASS=your-app-password
SMTP_FROM=Quzaurban <your-email@quzaurban.com>

# ============================================================
# GOOGLE OAUTH
# ============================================================
# Create credentials at console.cloud.google.com
# → APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application)
# Authorised redirect URI must include GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorised Redirect URI in your Google Cloud Console
GOOGLE_CALLBACK_URL=https://e-commerce-backend-qq8p.onrender.com/auth/google/callback
# After issuing the JWT the backend redirects to these app URLs with ?token=<jwt>
# Use the ?app= query param on /auth/google to pick which one (seller|buyer)
SELLER_APP_URL=https://seller.quzaurban.com
WEBAPP_URL=https://quzaurban.com
# Mobile OAuth client IDs (used to verify idTokens POSTed by the Mall app)
# Create these in Google Cloud Console → Credentials → Android/iOS OAuth client ID
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id
GOOGLE_IOS_CLIENT_ID=your-ios-client-id
