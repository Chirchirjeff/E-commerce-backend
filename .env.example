# ============================================================
# DATABASE
# ============================================================
# Neon pooled connection string (for app runtime on Render)
# In Neon dashboard: Connection Details → toggle "Pooled connection" ON → copy
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Neon direct (non-pooled) connection string (for prisma migrate on Render build)
# In Neon dashboard: Connection Details → toggle "Pooled connection" OFF → copy
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# APP
# ============================================================
PORT=4000
NODE_ENV=production

# ============================================================
# JWT
# ============================================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="your-jwt-secret-here"

# ============================================================
# CORS — comma-separated list of allowed frontend origins
# ============================================================
# Add all your deployed frontend URLs here
ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://seller.yourdomain.com

# ============================================================
# STOREFRONT URL
# ============================================================
# Public URL of E-commerce-webapp (used in payment confirmation emails)
STOREFRONT_URL=https://yourdomain.com

# ============================================================
# CLOUDINARY — image & video uploads
# ============================================================
# Get these from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: folder name inside your Cloudinary account
CLOUDINARY_FOLDER=quza

# ============================================================
# MPESA API KEYS
# ============================================================
CONSUMER_KEY=your-consumer-key
CONSUMER_SECRET=your-consumer-secret
PASSKEY=your-passkey
SHORT_CODE=174379
# Must be your live Render backend URL in production
MPESA_CALLBACK_URL=https://your-backend.onrender.com/mpesa/callback
SECURITY_CREDENTIAL=your-security-credential

# ============================================================
# EMAIL (Gmail SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
# Use a Gmail App Password (not your Gmail password)
# Generate at: myaccount.google.com/apppasswords
SMTP_PASS=your-app-password
SMTP_FROM=your-gmail@gmail.com
