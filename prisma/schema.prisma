// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  shops     Shop[]   
  orders    Order[]  
  createdAt DateTime @default(now())
}

model Shop {
  id          String    @id @default(uuid())
  name        String
  businessDescription String?
  businessLogo String?
  slug        String    @unique 
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  products    Product[]
  orders      Order[]
  categories  Category[]
  createdAt   DateTime  @default(now())
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String?
  price         Float
  stockQuantity Int      @default(0)
  thumbnailUrl  String?
  images        Json?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([shopId]) 
  @@index([categoryId])
}

model Order {
  id          String   @id @default(uuid())
  total       Float
  status      String   @default("pending")
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])
  createdAt   DateTime @default(now())

  @@index([shopId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime @default(now())

  @@index([shopId])
}
